PORT=5000

# Main app database (testimonials, leads, portfolio, auth, case studies, …)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tech2globe
DB_PORT=3306

# Blog database — separate from main (blog API only uses these)
# Usually same user/password as main DB (t2g_user → t2g_db + tech2globe_blog)
BLOG_DB_HOST=localhost
BLOG_DB_USER=root
BLOG_DB_PASSWORD=
BLOG_DB_NAME=tech2globe_blog
BLOG_DB_PORT=3306

# WordPress source (import:wp-blog + fix:blog-authors — needs read access to this DB)
WP_DB_HOST=localhost
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_NAME=buynfqw4_blogstech
WP_TABLE_PREFIX=wp_
WP_DB_PORT=3306

# Only for npm run migrate:blog (CREATE DATABASE) — optional
# MYSQL_ROOT_USER=root
# MYSQL_ROOT_PASSWORD=

CLIENT_URL_MAIN=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:3001

JWT_SECRET=change-me
ADMIN_EMAIL=admin@tech2globe.com
ADMIN_PASSWORD=change-me
# Set to true for cross-site admin cookies on staging (production uses NODE_ENV=production)
# AUTH_COOKIE_CROSS_SITE=true
TURNSTILE_SECRET=

# ElevenLabs agent transcript webhook
# Webhook URL in ElevenLabs dashboard (must use /api path — /transcript_webhook is not proxied on production):
# https://www.tech2globe.com/api/elevenlabs/webhook
ELEVENLABS_SECRET=
ELEVENLABS_TRANSCRIPT_EMAIL=
# Optional; defaults to SMTP_EMAIL / EMAIL_USER (must match Gmail SMTP auth address)
ELEVENLABS_FROM_EMAIL=
ELEVENLABS_SUBJECT_PREFIX=Chat Transcript

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=

SITE_URL=https://www.tech2globe.com
BLOG_MEDIA_BASE_URL=https://www.tech2globe.com
BLOG_DEFAULT_FEATURED_IMAGE=https://www.tech2globe.com/images/blog-bg.webp

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
